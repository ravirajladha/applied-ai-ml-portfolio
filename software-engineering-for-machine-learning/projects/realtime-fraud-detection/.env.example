# Copy to .env and adjust. Every value here has a working default in
# src/rtfd/config.py — this file exists to document what is tunable.

# --- Where bulk data goes ---------------------------------------------------
# The dataset (~470 MB) and the offline store need a few GB. If your system
# drive is short of space, point this at another volume — raw_dir and
# offline_dir follow it automatically. See ADR-0008.
RTFD_DATA_DIR=/mnt/a/rtfd-data

# --- Streaming --------------------------------------------------------------
RTFD_KAFKA_BOOTSTRAP=localhost:19092
RTFD_TOPIC_TRANSACTIONS=transactions

# --- Online feature store ---------------------------------------------------
RTFD_REDIS_URL=redis://localhost:6379/0

# --- Replay -----------------------------------------------------------------
# 1.0 = real time. Raise it to compress a day of traffic into minutes while
# developing. Latency measurements are only valid at 1.0.
RTFD_REPLAY_SPEED=60.0

# --- The cost model ---------------------------------------------------------
# These two numbers decide the block/approve threshold. They are assumptions,
# not measurements — see ADR-0004. Changing them changes system behaviour, so
# treat an edit here as a deployment.
RTFD_COST_MISSED_FRAUD_FIXED=500.0
RTFD_COST_FALSE_ALARM=300.0

# --- Logging ----------------------------------------------------------------
RTFD_LOG_LEVEL=INFO
