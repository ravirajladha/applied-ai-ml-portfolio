# LaTeX leaves a pile of intermediate files next to the source. None of them
# belong in git — every one is regenerated by ./build.sh.
.build/
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz

# main.pdf is a build artefact too. It is already covered by the portfolio's
# root .gitignore (*.pdf) and we deliberately do NOT re-include it: it changes
# on every build and would bloat the history. Run ./build.sh to see it.

# The reference PDFs in refs/ ARE tracked on purpose (~18 MB total), so the
# reading list travels with the paper and cannot rot when a link dies.
!refs/*.pdf

# Figures are tracked too. They are generated by the scripts beside them, but
# tracking the output means a fresh clone can build the paper without first
# having to run every figure script.
!figures/*.pdf
